<Window x:Class="Tembr.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Тембр" Width="1280" Height="860" MinWidth="1024" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0C1015"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />

    <Grid x:Name="StartupPanel" Background="#0C1015">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" />
        <ColumnDefinition Width="0.8*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="76,70,46,70" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="13" Background="#D9FF72">
            <TextBlock Text="Т" Foreground="#0C1015" FontSize="25" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="ТЕМБР" Foreground="#F4F6F8" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="VOICE STUDIO" Foreground="#8C99A9" FontSize="10" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="Твой голос.\nТвой тембр." Margin="0,54,0,18" Foreground="#F4F6F8"
                   FontSize="43" FontWeight="SemiBold" LineHeight="50" />
        <TextBlock Text="Локальная обработка в реальном времени" Foreground="#A5B0BD"
                   FontSize="16" />
        <Border Margin="0,34,0,0" Padding="16,13" CornerRadius="12"
                Background="#121820" BorderBrush="#252F3A" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="#D9FF72" VerticalAlignment="Center" />
            <TextBlock Text="ЗВУК ОСТАЁТСЯ НА ЭТОМ ПК" Margin="10,0,0,0"
                       Foreground="#A5B0BD" FontSize="10" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Column="1" Margin="18,24,24,24" Padding="34" CornerRadius="22"
              Background="#111820" BorderBrush="#202A35" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">
          <Grid Width="54" Height="54" HorizontalAlignment="Left" Margin="0,0,0,24">
            <Ellipse Stroke="#28343E" StrokeThickness="5" />
            <Ellipse x:Name="LoadingSpinner" Width="54" Height="54" Stroke="#D9FF72"
                     StrokeThickness="5" StrokeDashArray="2 8" StrokeStartLineCap="Round"
                     RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <RotateTransform />
              </Ellipse.RenderTransform>
              <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                       From="0" To="360" Duration="0:0:1.1" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Ellipse.Triggers>
            </Ellipse>
          </Grid>
          <TextBlock Text="ГОТОВИМ СТУДИЮ" Foreground="#D9FF72" FontSize="10"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="StartupStatus" Text="Запускаем аудиодвижок…" Margin="0,10,0,8"
                     Foreground="#F4F6F8" FontSize="21" FontWeight="SemiBold" />
          <TextBlock x:Name="StartupDetail"
                     Text="Первая загрузка модели может занять несколько секунд."
                     TextWrapping="Wrap" Foreground="#8C99A9" FontSize="13" LineHeight="20" />

          <StackPanel x:Name="ErrorActions" Visibility="Collapsed" Margin="0,24,0,0">
            <Button x:Name="RetryButton" Content="Повторить запуск" Click="Retry_Click"
                    Padding="16,11" HorizontalAlignment="Left" Background="#D9FF72"
                    Foreground="#0C1015" BorderThickness="0" FontSize="13"
                    FontWeight="SemiBold" Cursor="Hand" />
            <Button Content="Открыть журнал" Click="OpenLog_Click" Margin="0,10,0,0"
                    Padding="16,9" HorizontalAlignment="Left" Background="Transparent"
                    Foreground="#A5B0BD" BorderBrush="#35404C" BorderThickness="1"
                    FontSize="12" Cursor="Hand" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
