<Application x:Class="Tembr.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0C1015" />
    <SolidColorBrush x:Key="PanelBrush" Color="#121820" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D9FF72" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8C99A9" />
  </Application.Resources>
</Application>
